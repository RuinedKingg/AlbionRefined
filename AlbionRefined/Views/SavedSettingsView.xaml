<UserControl x:Class="AlbionRefined.Views.SavedSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBrush}">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel>
                <TextBlock Text="Saved settings" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Reusable refining configurations"
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Content="+   New saved setting"
                    Style="{StaticResource PrimaryButton}"
                    Width="135"/>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <UniformGrid Columns="2" Margin="0">
                    <Border Style="{StaticResource Card}" Margin="0,0,7,7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="Tier 4 Cloth (no focus)"
                                           FontWeight="SemiBold" FontSize="10"/>
                                <TextBlock DockPanel.Dock="Right" Text="⋮"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="Lymhurst • T4 • Normal"
                                       Style="{StaticResource SmallLabel}" Margin="0,6,0,12"/>
                            <DockPanel Grid.Row="2">
                                <TextBlock Text="Expected profit: +88,780"
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontSize="9"/>
                                <Button DockPanel.Dock="Right" Content="Load"
                                        Style="{StaticResource PrimaryButton}" Width="55"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="7,0,0,7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="Tier 5 Cloth - Enchanted"
                                           FontWeight="SemiBold" FontSize="10"/>
                                <TextBlock DockPanel.Dock="Right" Text="⋮"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="Bridgewatch • T5 • .2"
                                       Style="{StaticResource SmallLabel}" Margin="0,6,0,12"/>
                            <DockPanel Grid.Row="2">
                                <TextBlock Text="Expected profit: +181,450"
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontSize="9"/>
                                <Button DockPanel.Dock="Right" Content="Load"
                                        Style="{StaticResource PrimaryButton}" Width="55"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,7,7,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="Tier 4 - Focus efficient"
                                           FontWeight="SemiBold" FontSize="10"/>
                                <TextBlock DockPanel.Dock="Right" Text="⋮"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="Fort Sterling • T4 • .1"
                                       Style="{StaticResource SmallLabel}" Margin="0,6,0,12"/>
                            <DockPanel Grid.Row="2">
                                <TextBlock Text="Expected profit: +510,520"
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontSize="9"/>
                                <Button DockPanel.Dock="Right" Content="Load"
                                        Style="{StaticResource PrimaryButton}" Width="55"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="7,7,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="Tier 5 - Exceptional"
                                           FontWeight="SemiBold" FontSize="10"/>
                                <TextBlock DockPanel.Dock="Right" Text="⋮"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="Thetford • T5 • .3"
                                       Style="{StaticResource SmallLabel}" Margin="0,6,0,12"/>
                            <DockPanel Grid.Row="2">
                                <TextBlock Text="Expected profit: +1,742,950"
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontSize="9"/>
                                <Button DockPanel.Dock="Right" Content="Load"
                                        Style="{StaticResource PrimaryButton}" Width="55"/>
                            </DockPanel>
                        </Grid>
                    </Border>
                </UniformGrid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="10">
            <TextBlock Text="A saved setting stores resource, tier, enchantment, city, return rate and market assumptions."
                       Style="{StaticResource SmallLabel}"/>
        </Border>
    </Grid>
</UserControl>
