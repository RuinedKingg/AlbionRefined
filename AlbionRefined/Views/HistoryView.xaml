<UserControl x:Class="AlbionRefined.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBrush}">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="76"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Calculation history" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Review previous calculations and profitability"
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="CALCULATIONS" Style="{StaticResource SmallLabel}"/>
                    <TextBlock Text="8" FontSize="22" Margin="0,7,0,0" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="TOTAL PROFIT" Style="{StaticResource SmallLabel}"/>
                    <TextBlock Text="2,804,605" FontSize="18" Margin="0,9,0,0" Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="AVG. ROI" Style="{StaticResource SmallLabel}"/>
                    <TextBlock Text="89.06%" FontSize="18" Margin="0,9,0,0" Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="14,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PREVIOUS CALCULATIONS" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Your recent refining calculations"
                                   Style="{StaticResource SmallLabel}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="Clear history"
                            Style="{StaticResource PrimaryButton}" Width="90"
                            VerticalAlignment="Center"/>
                </DockPanel>

                <DataGrid Grid.Row="1" Style="{StaticResource DataGridBase}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DATE" Width="110"/>
                        <DataGridTextColumn Header="RESOURCE" Width="*"/>
                        <DataGridTextColumn Header="TIER" Width="65"/>
                        <DataGridTextColumn Header="CITY" Width="110"/>
                        <DataGridTextColumn Header="QUANTITY" Width="90"/>
                        <DataGridTextColumn Header="PROFIT" Width="110"/>
                        <DataGridTextColumn Header="ROI" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
