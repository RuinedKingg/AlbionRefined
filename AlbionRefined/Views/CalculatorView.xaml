<UserControl x:Class="AlbionRefined.Views.CalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBrush}">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Refining calculator" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Calculate focus cost, resources and expected profit"
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- Processing setup -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="PROCESSING SETUP" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Configure the resource you want to refine"
                                       Style="{StaticResource SmallLabel}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="Use focus"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="8"/>
                    </DockPanel>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Resource" Style="{StaticResource SmallLabel}"/>
                                <Border BorderBrush="#303832"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Background="#121714"
                                        Padding="1">

                                    <UniformGrid Columns="2">
                                        <RadioButton Content="Кожа"
                                                     Style="{StaticResource TierButton}"/>

                                        <RadioButton Content="Ткань"
                                                     Style="{StaticResource TierButton}"
                                                     IsChecked="True"/>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tier" Style="{StaticResource SmallLabel}"/>
                                <Border BorderBrush="#303832"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Background="#121714"
                                        Padding="1">

                                    <UniformGrid Columns="7">
                                        <RadioButton Content="T2"
                                                     Style="{StaticResource TierButton}"/>
                                        
                                        <RadioButton Content="T3"
                                                     Style="{StaticResource TierButton}"/>
                                        
                                        <RadioButton Content="T4"
                                                     Style="{StaticResource TierButton}"
                                                     IsChecked="True"/>

                                        <RadioButton Content="T5"
                                                     Style="{StaticResource TierButton}"/>

                                        <RadioButton Content="T6"
                                                     Style="{StaticResource TierButton}"/>

                                        <RadioButton Content="T7"
                                                     Style="{StaticResource TierButton}"/>

                                        <RadioButton Content="T8"
                                                     Style="{StaticResource TierButton}"/>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Enchantment" Style="{StaticResource SmallLabel}"/>
                                <Border BorderBrush="#303832"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Background="#121714"
                                        Padding="1">

                                    <UniformGrid Columns="5">
                                        <RadioButton Content=".0"
                                                     Style="{StaticResource TierButton}"
                                                     IsChecked="True"/>

                                        <RadioButton Content=".1"
                                                     Style="{StaticResource TierButton}"/>

                                        <RadioButton Content=".2"
                                                     Style="{StaticResource TierButton}"/>

                                        <RadioButton Content=".3"
                                                     Style="{StaticResource TierButton}"/>

                                        <RadioButton Content=".4"
                                                     Style="{StaticResource TierButton}"/>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Quantity" Style="{StaticResource SmallLabel}"/>
                                <TextBox Name="StackSize" Text="100"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Return rate" Style="{StaticResource SmallLabel}"/>
                                <TextBox Name="ReturnRate" Text="36.7%" LostFocus="PercentTextBox_LostFocus"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Usage fee" Style="{StaticResource SmallLabel}"/>
                                <TextBox Text="350"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Market tax" Style="{StaticResource SmallLabel}"/>
                                <TextBox Text="4.0%" Name="MarketTax" LostFocus="PercentTextBox_LostFocus"/>
                            </StackPanel>
                        </Grid>
                        
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Focus available" Style="{StaticResource SmallLabel}"/>
                                <TextBox Text="30,000"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Focus per craft" Style="{StaticResource SmallLabel}"/>
                                <TextBox Text="30"/>
                            </StackPanel>
                        </Grid>

                        <DockPanel Grid.Row="8">

                            <Button DockPanel.Dock="Right"
                                    Content="Calculate"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="105"
                                    Click="On_Calculate"/>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Profit summary -->
            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    BorderBrush="#55632C">
                <StackPanel>
                    <TextBlock Text="PROFIT SUMMARY" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="+88,780"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}"
                               Margin="0,12,0,2"/>
                    <TextBlock Text="Estimated profit"
                               Style="{StaticResource SmallLabel}"/>

                    <Separator Margin="0,14" Background="{StaticResource BorderBrush}"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Input cost" Style="{StaticResource SmallLabel}"/>
                        <TextBlock Grid.Row="0" Text="120,000" HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}" FontSize="9"/>

                        <TextBlock Grid.Row="1" Text="Output value" Style="{StaticResource SmallLabel}"/>
                        <TextBlock Grid.Row="1" Text="218,780" HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}" FontSize="9"/>

                        <TextBlock Grid.Row="2" Text="Station fee" Style="{StaticResource SmallLabel}"/>
                        <TextBlock Grid.Row="2" Text="4,000" HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}" FontSize="9"/>

                        <TextBlock Grid.Row="3" Text="Market tax" Style="{StaticResource SmallLabel}"/>
                        <TextBlock Grid.Row="3" Text="26,000" HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}" FontSize="9"/>

                        <TextBlock Grid.Row="4" Text="Focus efficiency" Style="{StaticResource SmallLabel}"/>
                        <TextBlock Grid.Row="4" Text="5,926 / 1k" HorizontalAlignment="Right" Foreground="{StaticResource SuccessBrush}" FontSize="9"/>
                    </Grid>

                    <Button Content="Save this calculation"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,15,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Resource composition -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="14,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RESOURCE COMPOSITION" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Materials required for this calculation"
                                   Style="{StaticResource SmallLabel}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Content="Export"
                            Width="65"
                            Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Center"/>
                </DockPanel>

                <DataGrid Grid.Row="1" Style="{StaticResource DataGridBase}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="RESOURCE" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="TIER" Binding="{Binding Tier}" Width="70"/>
                        <DataGridTextColumn Header="ENCHANTMENT" Binding="{Binding Enchant}" Width="100"/>
                        <DataGridTextColumn Header="REQUIRED" Binding="{Binding Required}" Width="100"/>
                        <DataGridTextColumn Header="PRICE" Binding="{Binding Price}" Width="100"/>
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding Total}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
