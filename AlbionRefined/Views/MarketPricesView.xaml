<UserControl x:Class="AlbionRefined.Views.MarketPricesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBrush}">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Market prices" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Manage imported market data used by the calculator"
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" Background="#182219" CornerRadius="3">
                        <TextBlock Text="↻" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontSize="14"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Excel price table loaded"
                                   FontSize="9" FontWeight="SemiBold"/>
                        <TextBlock Text="1,248 resources • Updated 2 minutes ago"
                                   Style="{StaticResource SmallLabel}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Refresh" Style="{StaticResource PrimaryButton}"
                            Width="70" Margin="0,0,7,0"/>
                    <Button Content="Import Excel" Style="{StaticResource PrimaryButton}"
                            Width="85"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="14,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="IMPORTED MARKET PRICES" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Current resource prices"
                                   Style="{StaticResource SmallLabel}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ComboBox Style="{StaticResource InputBox}" Width="110"
                                  SelectedIndex="0">
                            <ComboBoxItem>All cities</ComboBoxItem>
                            <ComboBoxItem>Bridgewatch</ComboBoxItem>
                            <ComboBoxItem>Caerleon</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </DockPanel>

                <DataGrid Grid.Row="1" Style="{StaticResource DataGridBase}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="RESOURCE" Width="2*"/>
                        <DataGridTextColumn Header="TIER" Width="65"/>
                        <DataGridTextColumn Header="ENCHANTMENT" Width="100"/>
                        <DataGridTextColumn Header="CITY" Width="110"/>
                        <DataGridTextColumn Header="BUY" Width="100"/>
                        <DataGridTextColumn Header="SELL" Width="100"/>
                        <DataGridTextColumn Header="UPDATED" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
