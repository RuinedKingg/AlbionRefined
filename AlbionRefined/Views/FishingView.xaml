<UserControl x:Class="AlbionRefined.Views.FishingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBrush}">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Fishing profit" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Calculate profit from fishing"
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="14,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="IMPORTED MARKET PRICES" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Current resource prices"
                                   Style="{StaticResource SmallLabel}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                       
                    </StackPanel>
                </DockPanel>

                <DataGrid Grid.Row="1" Style="{StaticResource DataGridBase}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="RESOURCE" Width="2*"/>
                        <DataGridTextColumn Header="TIER" Width="65"/>
                        <DataGridTextColumn Header="ENCHANTMENT" Width="100"/>
                        <DataGridTextColumn Header="CITY" Width="110"/>
                        <DataGridTextColumn Header="BUY" Width="100"/>
                        <DataGridTextColumn Header="SELL" Width="100"/>
                        <DataGridTextColumn Header="UPDATED" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

