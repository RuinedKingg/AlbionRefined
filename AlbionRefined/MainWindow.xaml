<Window x:Class="AlbionRefined.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Albion Refine"
        Width="1280"
        Height="760"
        MinWidth="1050"
        MinHeight="650"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="#242A26"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="62"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="105"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="22,18,18,0">
                    <TextBlock Text="Albion Refine"
                               FontSize="20"
                               FontFamily="{StaticResource Marcellus}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="RESOURCE CALCULATOR"
                               FontFamily="{StaticResource DmSans}"
                               Margin="0,3,0,0"
                               FontSize="10"
                               Foreground="{StaticResource DimTextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="15,40,15,0">
                    <Button x:Name="CalculatorButton"
                            Style="{StaticResource NavButton}"
                            Content="◉ Calculator"
                            Click="Calculator_Click"/>
                    

                    <Button x:Name="HistoryButton"
                            Style="{StaticResource NavButton}"
                            Content="◷ History"
                            Click="History_Click"/>

                    <Button x:Name="SavedSettingsButton"
                            Style="{StaticResource NavButton}"
                            Content="↓ Saved Settings"
                            Click="SavedSettings_Click"/>
                    
                    <Button x:Name="FishingButton"
                            Style="{StaticResource NavButton}"
                            Content="🐟 Fishing Profit"
                            Click="FishingProfit_Click"/>

                    <Button x:Name="MarketPricesButton"
                            Style="{StaticResource NavButton}"
                            Content="💹 Market Prices"
                            Click="MarketPrices_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="22,0,22,20">

                    <Button Style="{StaticResource NavButton}"
                            Content="⚙   Instruction"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Border Grid.Column="1" Background="{StaticResource WindowBrush}">
            <ContentControl x:Name="MainContent"/>
        </Border>
    </Grid>
</Window>