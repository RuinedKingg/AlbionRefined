<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna">

    <!-- Цвета хуйни -->
    <SolidColorBrush x:Key="WindowBrush" Color="#171b18"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#0d100e"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#1a1f1b"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#303631"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#940838"/>
    <SolidColorBrush x:Key="TextBrush" Color="#D8DDD9"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#7D857F"/>
    <SolidColorBrush x:Key="DimTextBrush" Color="#7D857F"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#940838"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#940838"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#D99E34"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D99E34"/>
    <SolidColorBrush x:Key="CheckBoxBackground" Color="#131714"/>
    
    <!-- Шрифты -->
    <FontFamily x:Key="Marcellus">/Fonts/#Marcellus</FontFamily>
    <FontFamily x:Key="DmSans">/Fonts/#DM Sans 14pt Light</FontFamily>
    
    
    <!-- большой заголовок -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Marcellus}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <!-- Мини подпись под заголовком -->
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="{StaticResource DmSans}"/>
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
    </Style>
    <!-- заголовок секции -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontFamily" Value="{StaticResource Marcellus}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <!-- Мини заголовки секций-->
    <Style x:Key="SmallLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{StaticResource DmSans}"/>
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
    </Style>
    <!-- белые цифры под большими желтыми -->
    <Style x:Key="SmallNumbers" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{StaticResource DmSans}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    
    <!-- Мини заголовки раздел 2 над цифрами-->
    <Style x:Key="SmallTitleLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontFamily" Value="{StaticResource DmSans}"/>
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
    </Style>
    
    <!-- Cost Breakdown цифры-->
    <Style x:Key="CostBreakdownNumbers" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="{StaticResource DmSans}"/>
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
    </Style>
    
    <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="{StaticResource CheckBoxBackground}"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
    <Style x:Key="ProfitMargin" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontFamily" Value="{StaticResource Marcellus}"/>
        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
    </Style>
<!-- Текст кнопок бокового меню-->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{StaticResource Marcellus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            BorderThickness="0">
                        <ContentPresenter
                            VerticalAlignment="Center"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#1A211C"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#222B24"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    
    <!--Стиль активного окна для ввода значений-->
   <Style x:Key="ResourceTextBox"
           TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="#252B24"/>
        <Setter Property="Foreground" Value="#E8E1D1"/>
        <Setter Property="BorderBrush" Value="#494838"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5 0 0 0"/>
        <Setter Property="CaretBrush" Value="#D1AD5B"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">

                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="#B79A53"/>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="#D1AD5B"/>
                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="#302F22"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border"
                                    Property="Opacity"
                                    Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#B79A53"/>
            </Trigger>

        </Style.Triggers>
    </Style>
    
    
    <!-- Добавленное ограничение рамки и значок-->
    <Style x:Key="PercentTextBox"
       TargetType="{x:Type TextBox}"
       BasedOn="{StaticResource ResourceTextBox}">

    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">

                <Border x:Name="InputBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <!-- Область ввода -->
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Grid.Column="0"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"/>

                        <!-- Вертикальная линия -->
                        <Border Grid.Column="1"
                                Background="#625A3F"
                                Margin="0,6"/>

                        <!-- Знак процента -->
                        <TextBlock Grid.Column="2"
                                   Text="%"
                                   Foreground="#D1AD5B"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Подсветка при наведении и вводе -->
                <ControlTemplate.Triggers>

                    <Trigger Property="IsMouseOver"
                             Value="True">
                        <Setter TargetName="InputBorder"
                                Property="BorderBrush"
                                Value="#B79A53"/>
                    </Trigger>

                    <Trigger Property="IsKeyboardFocused"
                             Value="True">
                        <Setter TargetName="InputBorder"
                                Property="BorderBrush"
                                Value="#D1AD5B"/>
                        <Setter TargetName="InputBorder"
                                Property="Background"
                                Value="#302F22"/>
                    </Trigger>

                    <Trigger Property="IsEnabled"
                             Value="False">
                        <Setter TargetName="InputBorder"
                                Property="Opacity"
                                Value="0.5"/>
                    </Trigger>

                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>

</Style>
    
    <!--Кнопка Посчитать в калькуляторе-->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Foreground" Value="#DDE3D9"/>
        <Setter Property="Background" Value="#2A321F"/>
        <Setter Property="BorderBrush" Value="#58652B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{StaticResource Marcellus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#394326"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#202619"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="TierButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#78827A" />
        <Setter Property="Background" Value="#121714" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}" />

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                        <!-- Полоска выбранной кнопки -->
                        <Border x:Name="SelectionIndicator"
                                Height="2"
                                Background="#C4A34D"
                                VerticalAlignment="Bottom"
                                Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Наведение -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBackground"
                                    Property="Background"
                                    Value="#1B211C" />
                            <Setter Property="Foreground"
                                    Value="#D5DCD5" />
                        </Trigger>

                        <!-- Выбранная кнопка -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ButtonBackground"
                                    Property="Background"
                                    Value="#29291E" />
                            <Setter Property="Foreground"
                                    Value="#DDB64F" />
                            <Setter TargetName="SelectionIndicator"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>

                        <!-- Отключённое состояние -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style x:Key="InputBox" TargetType="ComboBox">
        <Setter Property="Height" Value="27"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="#151B17"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="7,0"/>
    </Style>

    <Style x:Key="DataGridBase" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#202821"/>
        <Setter Property="VerticalGridLinesBrush" Value="#202821"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowBackground" Value="#101510"/>
        <Setter Property="AlternatingRowBackground" Value="#121813"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="ColumnHeaderHeight" Value="28"/>
        <Setter Property="RowHeight" Value="28"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#171D18"/>
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#151B17"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Padding" Value="7,4"/>
    </Style>

</ResourceDictionary>
